{
  "name": "skyyware/stage",
  "description": "A small PHP framework with explicit application boundaries.",
  "type": "library",
  "license": "MIT",
  "require": {"php": "^8.4", "ext-json": "*"},
  "require-dev": {"phpunit/phpunit": "^12.0", "phpstan/phpstan": "^2.1", "deptrac/deptrac": "^4.0"},
  "autoload": {"psr-4": {"Stage\\": "src/"}},
  "autoload-dev": {"psr-4": {"Stage\\Tests\\": "tests/", "Example\\": "examples/Features/"}},
  "scripts": {
    "check": ["@composer validate --strict", "phpstan analyse --no-progress", "phpunit", "deptrac analyse --no-progress --no-cache --fail-on-uncovered"]
  },
  "config": {"sort-packages": true, "allow-plugins": false}
}
